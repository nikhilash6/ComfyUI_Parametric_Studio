{
 "unet_h": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "wan2.2/wan2.2_fun_control_high_noise_14B_fp8_scaled.safetensors",
   "weight_dtype": "default"
  }
 },
 "unet_l": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "wan2.2/wan2.2_fun_control_low_noise_14B_fp8_scaled.safetensors",
   "weight_dtype": "default"
  }
 },
 "lora_h": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "unet_h",
    0
   ],
   "lora_name": "wan/accel/wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
   "strength_model": 1.0
  }
 },
 "lora_l": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "unet_l",
    0
   ],
   "lora_name": "wan/accel/wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
   "strength_model": 1.0
  }
 },
 "shift_h": {
  "class_type": "ModelSamplingSD3",
  "inputs": {
   "model": [
    "lora_h",
    0
   ],
   "shift": 8.0
  }
 },
 "shift_l": {
  "class_type": "ModelSamplingSD3",
  "inputs": {
   "model": [
    "lora_l",
    0
   ],
   "shift": 8.0
  }
 },
 "te": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
   "type": "wan",
   "device": "default"
  }
 },
 "vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "wan_2.1_vae.safetensors"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "te",
    0
   ],
   "text": "${prompt}"
  }
 },
 "neg": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "te",
    0
   ],
   "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走"
  }
 },
 "ref": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "${ref}"
  }
 },
 "ref_rs": {
  "class_type": "ResizeImageMaskNode",
  "inputs": {
   "input": [
    "ref",
    0
   ],
   "resize_type": "scale dimensions",
   "resize_type.width": "${width}",
   "resize_type.height": "${height}",
   "resize_type.crop": "center",
   "scale_method": "area"
  }
 },
 "vid": {
  "class_type": "LoadVideo",
  "inputs": {
   "file": "${control}"
  }
 },
 "comp": {
  "class_type": "GetVideoComponents",
  "inputs": {
   "video": [
    "vid",
    0
   ]
  }
 },
 "frames": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "comp",
    0
   ],
   "batch_index": 0,
   "length": 81
  }
 },
 "frames_rs": {
  "class_type": "ResizeImageMaskNode",
  "inputs": {
   "input": [
    "frames",
    0
   ],
   "resize_type": "scale dimensions",
   "resize_type.width": "${width}",
   "resize_type.height": "${height}",
   "resize_type.crop": "center",
   "scale_method": "area"
  }
 },
 "fc": {
  "class_type": "Wan22FunControlToVideo",
  "inputs": {
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "vae": [
    "vae",
    0
   ],
   "width": "${width}",
   "height": "${height}",
   "length": 81,
   "batch_size": 1,
   "ref_image": [
    "ref_rs",
    0
   ],
   "control_video": [
    "frames_rs",
    0
   ]
  }
 },
 "ks_h": {
  "class_type": "KSamplerAdvanced",
  "inputs": {
   "model": [
    "shift_h",
    0
   ],
   "add_noise": "enable",
   "noise_seed": "${seed}",
   "steps": 4,
   "cfg": 1.0,
   "sampler_name": "euler",
   "scheduler": "simple",
   "positive": [
    "fc",
    0
   ],
   "negative": [
    "fc",
    1
   ],
   "latent_image": [
    "fc",
    2
   ],
   "start_at_step": 0,
   "end_at_step": 2,
   "return_with_leftover_noise": "enable"
  }
 },
 "ks_l": {
  "class_type": "KSamplerAdvanced",
  "inputs": {
   "model": [
    "shift_l",
    0
   ],
   "add_noise": "disable",
   "noise_seed": 0,
   "steps": 4,
   "cfg": 1.0,
   "sampler_name": "euler",
   "scheduler": "simple",
   "positive": [
    "fc",
    0
   ],
   "negative": [
    "fc",
    1
   ],
   "latent_image": [
    "ks_h",
    0
   ],
   "start_at_step": 2,
   "end_at_step": 4,
   "return_with_leftover_noise": "disable"
  }
 },
 "dec": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "ks_l",
    0
   ],
   "vae": [
    "vae",
    0
   ]
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "video",
    0
   ],
   "filename_prefix": "${prefix}",
   "format": "auto",
   "codec": "auto"
  }
 },
 "video": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "dec",
    0
   ],
   "fps": [
    "comp",
    2
   ]
  }
 }
}