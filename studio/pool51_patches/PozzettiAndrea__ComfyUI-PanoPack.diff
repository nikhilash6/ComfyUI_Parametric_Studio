+# Parametric Studio patch: build-once, reuse-always.
+# - The isolated environment is built once, ahead of time (`comfy-env install` in this folder). It lives beside ComfyUI in
+#   `<ComfyUI's parent>/comfy-env` unless COMFY_ENV_ROOT is set. Starting ComfyUI never downloads or installs anything:
+#   comfy-env only reports whether that environment exists, and skips the nodes that need it if it does not.
+# - The bundled test images are no longer copied into ComfyUI/input at every start.
+# - ComfyUI's folder comes from main.py, not from this file's resolved path (the pack is often a symlink).
+import os
+import sys
 from pathlib import Path
 
-from comfy_env import copy_files, setup_env
-from comfy_3d_viewers import copy_viewer
+SCRIPT_DIR = Path(__file__).resolve().parent
+_main = getattr(sys.modules.get("__main__"), "__file__", None)
+COMFYUI_DIR = Path(_main).resolve().parent if _main else Path(__file__).absolute().parent.parent.parent
+os.environ.setdefault("COMFY_ENV_ROOT", str(COMFYUI_DIR.parent / "comfy-env"))
 
-setup_env()
