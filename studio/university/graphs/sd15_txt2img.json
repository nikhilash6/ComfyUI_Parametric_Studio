{
 "meta": {
  "title": "The classic text-to-image graph",
  "about": "Seven nodes. Almost every image graph is this with parts swapped.",
  "runs": "model",
  "needs": [
   "An SD 1.5 checkpoint in models/checkpoints (we used v1-5-pruned-emaonly). Any SD 1.5 file works; pick yours in the loader."
  ],
  "packs": [],
  "notes": {
   "1": "Reads one file and hands out three things: the denoiser, the text encoder and the VAE.",
   "2": "Turns the prompt into conditioning.",
   "3": "The negative prompt. It is the other half of CFG.",
   "4": "An empty latent. KSampler adds the noise.",
   "5": "Runs the sampling loop.",
   "6": "Latent to pixels.",
   "7": "Writes the PNG."
  }
 },
 "graph": {
  "1": {
   "class_type": "CheckpointLoaderSimple",
   "inputs": {
    "ckpt_name": "v1-5-pruned-emaonly.safetensors"
   }
  },
  "2": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "a weathered brass astrolabe on an oak table, warm window light, photograph",
    "clip": [
     "1",
     1
    ]
   }
  },
  "3": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "blurry, low quality, watermark, text",
    "clip": [
     "1",
     1
    ]
   }
  },
  "4": {
   "class_type": "EmptyLatentImage",
   "inputs": {
    "width": 512,
    "height": 512,
    "batch_size": 1
   }
  },
  "5": {
   "class_type": "KSampler",
   "inputs": {
    "model": [
     "1",
     0
    ],
    "seed": 424242,
    "steps": 20,
    "cfg": 7.0,
    "sampler_name": "euler",
    "scheduler": "karras",
    "positive": [
     "2",
     0
    ],
    "negative": [
     "3",
     0
    ],
    "latent_image": [
     "4",
     0
    ],
    "denoise": 1.0
   }
  },
  "6": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "5",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "7": {
   "class_type": "SaveImage",
   "inputs": {
    "images": [
     "6",
     0
    ],
    "filename_prefix": "university"
   }
  }
 }
}
