{
 "meta": {
  "title": "KSampler taken apart",
  "about": "The five parts of a KSampler as separate nodes, so you can swap each one.",
  "runs": "model",
  "needs": [
   "An SD 1.5 checkpoint in models/checkpoints (we used v1-5-pruned-emaonly). Any SD 1.5 file works; pick yours in the loader."
  ],
  "packs": [],
  "notes": {
   "5": "Where the noise comes from.",
   "6": "How model calls become one prediction: here, CFG.",
   "7": "The update rule.",
   "8": "The list of noise levels.",
   "9": "Does what KSampler does, from these four separate parts."
  }
 },
 "graph": {
