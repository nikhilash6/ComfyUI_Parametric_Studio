{
 "meta": {
  "title": "Depth with core MoGe, into a ControlNet",
  "about": "Make the depth map in core, look at it, then control with it.",
  "runs": "model",
  "needs": [
   "An SD 1.5 checkpoint in models/checkpoints (we used v1-5-pruned-emaonly). Any SD 1.5 file works; pick yours in the loader.",
   "A depth ControlNet for SD 1.5 in models/controlnet.",
   "A MoGe model in models/geometry_estimation."
  ],
  "packs": [],
  "notes": {
   "7": "Depth as a grey image: near is white, spaced by 1/depth.",
   "8": "Look before you control.",
   "10": "The grey map is an ordinary IMAGE here. Pick a ControlNet that takes depth."
  }
 },
 "graph": {
  "1": {
   "class_type": "CheckpointLoaderSimple",
   "inputs": {
    "ckpt_name": "v1-5-pruned-emaonly.safetensors"
   }
  },
  "2": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "a weathered brass astrolabe on an oak table, warm window light, photograph",
    "clip": [
     "1",
     1
    ]
   }
  },
  "3": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "blurry, low quality, watermark, text",
    "clip": [
     "1",
     1
    ]
   }
  },
  "4": {
   "class_type": "EmptyLatentImage",
   "inputs": {
    "width": 512,
    "height": 512,
    "batch_size": 1
   }
  },
  "5": {
   "class_type": "LoadImage",
   "inputs": {
    "image": "example.png"
   }
  },
  "6": {
   "class_type": "LoadMoGeModel",
   "inputs": {
    "model_name": "moge_2_vitl_normal_fp16.safetensors"
   }
  },
  "61": {
   "class_type": "MoGeInference",
   "inputs": {
    "moge_model": [
     "6",
     0
    ],
    "image": [
     "5",
     0
    ],
    "resolution_level": 9,
    "fov_x_degrees": 0.0,
    "batch_size": 4,
    "force_projection": true,
    "apply_mask": true,
    "refine_steps": 3
   }
  },
  "7": {
   "class_type": "MoGeRender",
   "inputs": {
    "moge_geometry": [
     "61",
     0
    ],
    "output": "depth"
   }
  },
  "8": {
   "class_type": "PreviewImage",
   "inputs": {
    "images": [
     "7",
     0
    ]
   }
  },
  "9": {
   "class_type": "ControlNetLoader",
   "inputs": {
    "control_net_name": "control_v11f1p_sd15_depth.safetensors"
   }
  },
  "10": {
   "class_type": "ControlNetApplyAdvanced",
   "inputs": {
    "positive": [
     "2",
     0
    ],
    "negative": [
     "3",
     0
    ],
    "control_net": [
     "9",
     0
    ],
    "image": [
     "7",
     0
    ],
    "strength": 1.0,
    "start_percent": 0.0,
    "end_percent": 0.8
   }
  },
  "11": {
   "class_type": "KSampler",
   "inputs": {
    "model": [
     "1",
     0
    ],
    "seed": 424242,
    "steps": 20,
    "cfg": 7.0,
    "sampler_name": "euler",
    "scheduler": "karras",
    "denoise": 1.0,
    "positive": [
     "10",
     0
    ],
    "negative": [
     "10",
     1
    ],
    "latent_image": [
     "4",
     0
    ]
   }
  },
  "12": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "11",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "13": {
   "class_type": "SaveImage",
   "inputs": {
    "images": [
     "12",
     0
    ],
    "filename_prefix": "university"
   }
  }
 }
}