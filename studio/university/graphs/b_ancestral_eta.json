{
 "meta": {
  "title": "Turn ancestral noise up and down",
  "about": "eta on SamplerEulerAncestral, at 0 it is plain Euler.",
  "runs": "model",
  "needs": [
   "An SD 1.5 checkpoint in models/checkpoints (we used v1-5-pruned-emaonly). Any SD 1.5 file works; pick yours in the loader."
  ],
  "packs": [],
  "notes": {
   "5": "Where the first noise comes from.",
   "6": "eta 1 is what the euler_ancestral name uses. Try 0, 0.5 and 1 with the same seed.",
   "7": "Runs the parts together."
  }
 },
 "graph": {
  "1": {
   "class_type": "CheckpointLoaderSimple",
   "inputs": {
    "ckpt_name": "v1-5-pruned-emaonly.safetensors"
   }
  },
  "2": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "a weathered brass astrolabe on an oak table, warm window light, photograph",
    "clip": [
     "1",
     1
    ]
   }
  },
  "3": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "blurry, low quality, watermark, text",
    "clip": [
     "1",
     1
    ]
   }
  },
  "4": {
   "class_type": "EmptyLatentImage",
   "inputs": {
    "width": 512,
    "height": 512,
    "batch_size": 1
   }
  },
  "5": {
   "class_type": "BasicScheduler",
   "inputs": {
    "model": [
     "1",
     0
    ],
    "scheduler": "karras",
    "steps": 20,
    "denoise": 1.0
   }
  },
  "6": {
   "class_type": "SamplerEulerAncestral",
   "inputs": {
    "eta": 0.5,
    "s_noise": 1.0
   }
  },
  "7": {
   "class_type": "SamplerCustom",
   "inputs": {
    "model": [
     "1",
     0
    ],
    "add_noise": true,
    "noise_seed": 424242,
    "cfg": 7.0,
    "positive": [
     "2",
     0
    ],
    "negative": [
     "3",
     0
    ],
    "sampler": [
     "6",
     0
    ],
    "sigmas": [
     "5",
     0
    ],
    "latent_image": [
     "4",
     0
    ]
   }
  },
  "8": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "7",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "9": {
   "class_type": "SaveImage",
   "inputs": {
    "images": [
     "8",
     0
    ],
    "filename_prefix": "university"
   }
  }
 }
}